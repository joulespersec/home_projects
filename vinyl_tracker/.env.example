# --- Spotify (Stage 1) ---
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Discogs (Stage 2) ---
# Discogs -> Settings -> Developers -> "Generate new token" (personal use).
DISCOGS_TOKEN=your_discogs_personal_token_here
# Discogs requires a descriptive User-Agent; override the default if you like.
DISCOGS_USER_AGENT=VinylTracker/0.1 +https://github.com/joulespersec/home_projects
